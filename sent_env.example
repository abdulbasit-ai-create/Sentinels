# ============================================================
#  Sentinels — Environment Variables
#  Copy this file to .env and fill in your keys
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Groq AI API Key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── GROQ MODEL CONFIGURATION ──────────────────────────────────
# Preferred model (leave empty for auto-select based on task)
# Supported models (July 2026):
#   Production:  llama-3.1-8b-instant, llama-3.3-70b-versatile,
#                openai/gpt-oss-20b, openai/gpt-oss-120b
#   Preview:     meta-llama/llama-4-scout-17b-16e-instruct,
#                qwen/qwen3-32b, qwen/qwen3.6-27b
#   Agentic:     groq/compound, groq/compound-mini
# Default (auto): openai/gpt-oss-20b (fast & capable)
GROQ_MODEL=

# Enable automatic fallback to next model if current one fails (default: true)
GROQ_MODEL_FALLBACK_ENABLED=true

# Enable API-based model discovery at startup (default: true)
# When enabled, fetches live model list from api.groq.com/openai/v1/models
GROQ_MODEL_DISCOVERY=true

# Skip deprecated models in fallback chain (default: false)
# Deprecated: llama-3.1-8b-instant, llama-3.3-70b-versatile,
#             qwen/qwen3-32b, meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_SKIP_DEPRECATED=false

# Maximum fallback retries before giving up (default: 3)
GROQ_MODEL_MAX_RETRIES=3

# Model list cache TTL in milliseconds (default: 1 hour)
MODEL_CACHE_TTL_MS=3600000

# ── OPTIONAL (improves accuracy) ─────────────────────────────
# Google Safe Browsing API (free at console.cloud.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# PhishTank API Key (free at phishtank.com/api_info.php)
PHISHTANK_KEY=your_phishtank_key_here

# URLhaus API Key (free at abuse.ch - get from https://urlhaus.abuse.ch/api/)
URLHAUS_KEY=your_urlhaus_api_key_here

# ── SERVER ───────────────────────────────────────────────────
PORT=3001

# ── SECURITY (REQUIRED FOR PRODUCTION) ───────────────────────
# Generate a strong random key: openssl rand -base64 32
SENT_API_KEY=change_me_to_a_strong_random_key

# Lock down CORS to your specific Chrome extension ID
# Get from chrome://extensions after uploading
EXTENSION_ID=

# Disable localhost in production (set to false)
ALLOW_LOCALHOST=true
